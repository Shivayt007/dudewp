# Only set on the server! Never prefix these with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=movie_wallet
BIGGBOSS_COLLECTION=biggboss_episodes

# Match the already-deployed TgLink signing key from reference/temp_links.py.
# The reference you supplied uses exactly "bot". Keep server-side only.
TEMP_LINK_SECRET=REPLACE_WITH_THE_DEPLOYED_TGLINK_SIGNING_SECRET
TEMP_LINK_BASE_URL=https://telegram.tglink.space
TEMP_LINK_EXPIRY_SECONDS=5600

# OPTIONAL: Used to show Telegram posters from poster_file_id.
# Must be a bot allowed to access those files; never put it in browser code.
TELEGRAM_POSTER_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# OPTIONAL: Site metadata
NEXT_PUBLIC_SITE_NAME=Dude Bigg Boss Tamil

# Legacy server bridge only. The Movi browser player bypasses it.
# Leave false to avoid VPS conversion; embedded tracks are decoded in the browser.
ENABLE_MKV_HLS=false
# Optional fallback for posters saved locally by the old ads/main14 bot.
# Point to the EXISTING, accessible MovieBot static poster directory URL.
# Example: https://old-movie-site.example/static/images/posters
POSTER_SOURCE_BASE_URL=
